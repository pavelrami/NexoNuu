PORT=3001
# Escribe tu cadena de conexion local. No compartas contrasenas ni subas el archivo .env a GitHub.
# DATABASE_URL=postgresql://postgres:TU_CONTRASENA@localhost:5432/nexo_nuu

# URL de tu web, usada para verificar origen y construir enlaces de correo.
APP_URL=http://localhost:5173
NODE_ENV=development

# Solo desarrollo local: la terminal imprime un enlace de prueba.
EMAIL_MODE=console
# Para correo real: EMAIL_MODE=resend, RESEND_API_KEY y EMAIL_FROM.
# RESEND_API_KEY=...
# EMAIL_FROM=Nexo Nuu <verificacion@tudominio.com>
