PORT=3001
# Escribe tu cadena de conexion local. No compartas contrasenas ni subas el archivo .env a GitHub.
# DATABASE_URL=postgresql://postgres:TU_CONTRASENA@localhost:5432/nexo_nuu

# URL publica de tu web: se usa para los enlaces de los correos y para Google.
# En el VPS: APP_URL=https://tudominio.com
APP_URL=http://localhost:5173
NODE_ENV=development

# ===== Correo =====
# console = solo desarrollo: el enlace se imprime en la terminal del backend.
# smtp    = envia a la bandeja real (Hostinger, Gmail con contrasena de aplicacion, Outlook...).
# resend  = API de Resend con dominio verificado.
EMAIL_MODE=console
# EMAIL_FROM=Nexo Nuu <no-responder@tudominio.com>
#
# --- SMTP de Hostinger (correo de tu dominio) ---
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=no-responder@tudominio.com
# SMTP_PASS=contrasena_del_buzon
#
# --- SMTP de Gmail (requiere verificacion en 2 pasos y una "contrasena de aplicacion") ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tucuenta@gmail.com
# SMTP_PASS=contrasena_de_aplicacion_de_16_letras
# EMAIL_FROM=Nexo Nuu <tucuenta@gmail.com>
#
# --- Resend ---
# RESEND_API_KEY=...

# ===== Inicio de sesion con Google =====
# Crea un "ID de cliente de OAuth" (aplicacion web) en Google Cloud y autoriza esta URI de redireccion:
#   {APP_URL}/api/auth/google/callback   (local: http://localhost:5173/api/auth/google/callback)
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...

# ===== Jornadas de demostracion =====
# 1 = las jornadas marcadas como demostracion aceptan postulaciones y se gestionan desde el panel.
ALLOW_DEMO_POSTULACIONES=1

# ===== Verificacion telefonica =====
# 1 = exige telefono verificado para postularse (necesita un proveedor de SMS; SMS_MODE=console solo funciona en local).
TELEFONO_OBLIGATORIO=0
SMS_MODE=console

# ===== Cuentas de demostracion (npm run db:seed:demo -- --confirmar) =====
# Opcional: correos para las 3 cuentas. Si no los indicas se usan direcciones @nexonuu.test.
# SEED_ADMIN_CORREO=
# SEED_INSTITUCION_CORREO=
# SEED_VOLUNTARIO_CORREO=
